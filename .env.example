# Copy this file to .env and fill in real values. Never commit .env.
# On the MilesWeb server, the same DB_* / UPLOAD_DIR values go in a .env file
# inside the Node.js app folder (not in public_html).

# --- MySQL (MilesWeb cPanel → MySQL Databases) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpaneluser_navswar
DB_USER=cpaneluser_navswar
DB_PASSWORD=change-me

# Where uploaded comment audio is stored. Use a folder OUTSIDE the deploy folder on the server,
# e.g. /home/cpaneluser/navswar-uploads, so deployments never delete it.
UPLOAD_DIR=uploads

# Local API port for `npm run dev:server` (cPanel sets its own port in production)
PORT=3001
