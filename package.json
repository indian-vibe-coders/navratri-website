{
  "name": "navratri-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node -e \"import('fs').then(fs => fs.copyFileSync('dist/index.html', 'dist/404.html'))\"",
    "lint": "oxlint",
    "preview": "vite preview",
    "db:test-neon": "node --env-file=.env scripts/testNeon.ts",
    "build:server": "node server/build.mjs",
    "dev:server": "node --watch server/src/app.ts",
    "db:migrate": "node server/src/migrate.ts",
    "library:build": "node scripts/buildLibrary.ts"
  },
  "dependencies": {
    "@neon/config": "^1.7.3",
    "@neon/env": "^1.4.4",
    "@neondatabase/serverless": "^1.1.0",
    "@types/pg": "^8.23.1",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "compression": "^1.8.2",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "lucide-react": "^1.48.0",
    "multer": "^2.4.0",
    "mysql2": "^3.24.5",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.13.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
