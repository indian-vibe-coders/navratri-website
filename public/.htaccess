<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Do not rewrite existing physical files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Rewrite all frontend SPA routes (e.g., /garba/*, /library, /favorites) to index.html
  RewriteRule ^ index.html [L]
</IfModule>
